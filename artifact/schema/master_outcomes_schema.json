{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KDD2027 benchmark-audit analysis-ready dataset (master_outcomes.csv)",
  "description": "One row per benchmark release (frozen commit). The independent sampling unit.",
  "type": "array",
  "minItems": 26,
  "maxItems": 26,
  "items": {
    "type": "object",
    "required": [
      "benchmark",
      "category",
      "A0_described",
      "A1_accessible",
      "R2_reconstructable",
      "n_ok_of_5",
      "first_pass_label",
      "E3_first_pass",
      "E3_after_repair",
      "E3_smoke_testable"
    ],
    "properties": {
      "benchmark": {
        "type": "string"
      },
      "category": {
        "type": "string",
        "enum": [
          "code-gen",
          "text2sql",
          "tabular",
          "ml-eng",
          "e2e-agent"
        ]
      },
      "frozen_commit": {
        "type": "string"
      },
      "A0_described": {
        "type": "integer",
        "enum": [
          0,
          1
        ]
      },
      "A1_accessible": {
        "type": "integer",
        "enum": [
          0,
          1
        ]
      },
      "R2_reconstructable": {
        "type": "integer",
        "enum": [
          0,
          1
        ]
      },
      "n_ok_of_5": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5
      },
      "first_pass_label": {
        "type": "string",
        "enum": [
          "pass-as-documented",
          "pass-after-minimal-repair",
          "missing-evaluator",
          "missing-required-data",
          "access-or-license-blocked",
          "credential-or-service-blocked",
          "dependency-or-environment-failure",
          "resource-cap-exceeded",
          "unsupported-output-schema",
          "not-applicable"
        ]
      },
      "E3_first_pass": {
        "type": "integer",
        "enum": [
          0,
          1
        ]
      },
      "E3_after_repair": {
        "type": "integer",
        "enum": [
          0,
          1
        ]
      },
      "E3_smoke_testable": {
        "type": "integer",
        "enum": [
          0,
          1
        ]
      },
      "evaluator": {
        "type": "integer",
        "enum": [
          0,
          1
        ]
      },
      "dataset": {
        "type": "integer",
        "enum": [
          0,
          1
        ]
      },
      "sample_predictions": {
        "type": "integer",
        "enum": [
          0,
          1
        ]
      },
      "env_file": {
        "type": "integer",
        "enum": [
          0,
          1
        ]
      },
      "container": {
        "type": "integer",
        "enum": [
          0,
          1
        ]
      },
      "license": {
        "type": "integer",
        "enum": [
          0,
          1
        ]
      }
    }
  }
}